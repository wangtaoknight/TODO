<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.4.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.4.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TODO">
      <HintPath>..\TODO\bin\Debug\TODO.exe</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyProductionOutput" AfterTargets="Build">
    <ItemGroup>
      <ProductionOutput Include="..\TODO\bin\$(Configuration)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProductionOutput)" DestinationFiles="@(ProductionOutput->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>

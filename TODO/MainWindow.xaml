<Window x:Class="TODO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TODO · 任务管理" Height="720" Width="1120"
        MinHeight="560" MinWidth="860"
        Background="#F5F7FB" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#778197" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#5B5FEF" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <DataTemplate x:Key="TaskTemplate">
            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Margin="0,4,14,0" IsChecked="{Binding IsCompleted, Mode=TwoWay}" Click="TaskCompleted_Click" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextDecorations" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Opacity" Value="0.5" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" MaxHeight="22" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Background="#EEF0FF" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding Priority, StringFormat=优先级：{0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DueDate, StringFormat=截止：{0:yyyy-MM-dd}}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="编辑" Tag="{Binding}" Style="{StaticResource FlatButton}" Click="EditTask_Click" />
                        <Button Content="删除" Tag="{Binding}" Style="{StaticResource FlatButton}" Foreground="#D95368" Click="DeleteTask_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="18" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TODO" FontSize="27" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="把每件事做好" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,28" />
                    <Button Content="全部任务" Tag="All" Style="{StaticResource NavButton}" Click="Filter_Click" />
                    <Button Content="进行中" Tag="Active" Style="{StaticResource NavButton}" Click="Filter_Click" />
                    <Button Content="已完成" Tag="Completed" Style="{StaticResource NavButton}" Click="Filter_Click" />
                    <Button Content="今天到期" Tag="Today" Style="{StaticResource NavButton}" Click="Filter_Click" />
                    <Button Content="已逾期" Tag="Overdue" Style="{StaticResource NavButton}" Click="Filter_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                    <TextBlock Text="任务概览" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="TotalText" Foreground="{StaticResource MutedBrush}" Margin="0,3" />
                    <TextBlock x:Name="ActiveText" Foreground="{StaticResource MutedBrush}" Margin="0,3" />
                    <TextBlock x:Name="CompletedText" Foreground="{StaticResource MutedBrush}" Margin="0,3" />
                    <TextBlock x:Name="OverdueText" Foreground="#D95368" Margin="0,3" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,4,0,24">
                <StackPanel>
                    <TextBlock Text="我的任务" FontSize="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="FilterTitle" Text="全部任务" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="＋ 新建任务" HorizontalAlignment="Right" Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="18,10" BorderThickness="0" Click="AddTask_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="38" Padding="12,8" BorderBrush="#E1E5EF" Background="White" TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="搜索任务、分类或描述" IsHitTestVisible="False" Margin="12,10,0,0" Foreground="#A2A9B8" />
                <ComboBox x:Name="SortBox" Grid.Column="1" Margin="12,0,0,0" Height="38" SelectionChanged="SortBox_SelectionChanged" />
            </Grid>
            <Grid Grid.Row="2">
                <ListBox x:Name="TaskList" ItemsSource="{Binding}" ItemTemplate="{StaticResource TaskTemplate}" BorderThickness="0" Background="Transparent" />
                <TextBlock x:Name="EmptyText" Text="还没有任务，创建一件要完成的事吧。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
